\@writefile{lot}{\contentsline {table}{\numberline {1.2}{\ignorespaces Resonant drive $v_q/v_{te}=0.03$ across models: collapse time of $W_{\rm  ext}$ ($10\,\%$ departure from the nonrelativistic linear law), mean-field energy over its linear value at $\omega _{pe}t=1000$, HHS-measure heating at $1000$, and the time to which the model is valid. $^\dagger $Shot-noise seeds: the values are at $1000$ but the runs lose positivity earlier, so they are not results; ranges are over particle numbers $2\times 10^{4}$--$2\times 10^{5}$ per cell and $N_x=32$--$128$. PIC: seed mean at 412 particles per cell (five seeds relativistic, two Newtonian). The Hermite row is $N_x=32$, $N_n=64$. HHS: read from their Fig.\nobreakspace  {}2 and SM.}}{8}{table.1.2}\protected@file@percent }
\newlabel{tab:c10-comp}{{1.2}{8}{Resonant drive $\vq =0.03$ across models: collapse time of $\Wext $ ($10\,\%$ departure from the nonrelativistic linear law), mean-field energy over its linear value at $\wpe t=1000$, HHS-measure heating at $1000$, and the time to which the model is valid. $^\dagger $Shot-noise seeds: the values are at $1000$ but the runs lose positivity earlier, so they are not results; ranges are over particle numbers $2\times 10^{4}$--$2\times 10^{5}$ per cell and $N_x=32$--$128$. PIC: seed mean at 412 particles per cell (five seeds relativistic, two Newtonian). The Hermite row is $N_x=32$, $N_n=64$. HHS: read from their Fig.~2 and SM}{table.1.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces Resonant drive $v_q/v_{te}=0.03$ (figure of the paper). (a) Mean-field energy over the exact linear law (trailing $200\,\omega _{pe}^{-1}$ mean) for the nonrelativistic Hermite model, the relativistic grid, the relativistic Hermite model and the relativistic and Newtonian PIC. (b) HHS measure of the $k\ne  0$ electron energy change over $E_{\rm  th}$ (symmetric logarithmic scale); squares: HHS Fig.\nobreakspace  {}2 re-digitized. The continuum curves coincide to $\omega _{pe}t=1000$ and remain below $\sim 1\,E_{\rm  th}$ to $2000$. (c) Heating at $\omega _{pe}t=1000$ against particles per cell, with the relativistic plateau, the Newtonian PIC, mirrored loading, the HHS value and the continuum value.}}{8}{figure.1.1}\protected@file@percent }
\newlabel{fig:c10-hhs}{{1.1}{8}{Resonant drive $\vq =0.03$ (figure of the paper). (a) Mean-field energy over the exact linear law (trailing $200\,\wpe ^{-1}$ mean) for the nonrelativistic Hermite model, the relativistic grid, the relativistic Hermite model and the relativistic and Newtonian PIC. (b) HHS measure of the $k\ne 0$ electron energy change over $\Eth $ (symmetric logarithmic scale); squares: HHS Fig.~2 re-digitized. The continuum curves coincide to $\wpe t=1000$ and remain below $\sim 1\,\Eth $ to $2000$. (c) Heating at $\wpe t=1000$ against particles per cell, with the relativistic plateau, the Newtonian PIC, mirrored loading, the HHS value and the continuum value}{figure.1.1}{}}
